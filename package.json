{
  "name": "@kick-playr/local-key-vault",
  "version": "0.1.4",
  "private": true,
  "description": "NestJS local development vault with an explicit Azure Key Vault REST subset",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:oauth": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.oauth.config.cjs --runInBand",
    "test:audit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.audit.config.cjs --runInBand",
    "maint:update": "ncu -u -t minor && npm install && npm audit fix --audit-level moderate && npm install",
    "test:discovery": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.discovery.config.cjs --runInBand",
    "test:runtime-manifests": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.runtime-manifests.config.cjs --runInBand",
    "test:manifest-plan": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.manifest-plan.config.cjs --runInBand",
    "test:grant-export": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.grant-export.config.cjs --runInBand",
    "test:inventory": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.inventory-unit.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.3",
    "glob": "14.0.3",
    "deepmerge": "4.3.1"
  },
  "exports": {
    "./runtime-client": {
      "types": "./runtime-client/index.d.cts",
      "require": "./runtime-client/index.cjs",
      "import": "./runtime-client/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "runtime-client": [
        "runtime-client/index.d.ts"
      ]
    }
  },
  "files": [
    "runtime-client/"
  ]
}
