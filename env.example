# Copy to .env in the project root. Fill the required blank values before startup.
# .env is ignored by Git. Keep it private; never commit real bootstrap credentials.
# Already exported environment variables take precedence over this file.

VAULT_BASE_URL=http://127.0.0.1:4000

# MongoDB connection URL. Database and optional credentials belong in the URL.
# An explicit database path is required; startup fails if it is missing.
VAULT_MONGODB_URI=mongodb://127.0.0.1:27017/key-vault

# Required: base64 encoding of exactly 32 random bytes. Retain across restarts.
VAULT_MASTER_KEY=

# Caller grants live encrypted in MongoDB, not in .env.
# First grant: ./create-grants.sh dev tenant-123 read,write,crypto,list
# Existing installation: ./migrate-grants.sh, then remove VAULT_GRANTS from .env.
